#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
export PGDATA="$root/.dev/postgres"
export PGPORT="${PGPORT:-54329}"

case "${1:-}" in
  up)
    mkdir -p "$root/.dev"
    if [ ! -d "$PGDATA" ]; then
      initdb --username=postgres --auth=trust --no-locale --encoding=UTF8 >/dev/null
    fi
    pg_ctl status >/dev/null 2>&1 ||
      pg_ctl start --wait --log="$root/.dev/postgres.log" \
        --options="-p $PGPORT -c listen_addresses=localhost -c unix_socket_directories=$root/.dev"
    echo "postgres listening on localhost:$PGPORT"
    ;;
  down)
    pg_ctl status >/dev/null 2>&1 && pg_ctl stop --wait
    ;;
  *)
    echo "usage: bin/dev-services up|down" >&2
    exit 64
    ;;
esac
